<Window
    x:Class="PasswordVault.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Password Vault">

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Seiten (laufen unter der Titelleiste durch) -->
        <Frame x:Name="RootFrame" Grid.RowSpan="2" />

        <!-- Eigene Titelleiste -->
        <Grid x:Name="AppTitleBar"
              Grid.Row="0"
              Padding="16,0,0,0"
              Background="Transparent">
            <StackPanel Orientation="Horizontal"
                        Spacing="10"
                        VerticalAlignment="Center">
                <Border Width="22" Height="22"
                        CornerRadius="7"
                        Background="{StaticResource VaultGradientBrush}">
                    <FontIcon Glyph="&#xE72E;"
                              FontSize="11"
                              Foreground="White" />
                </Border>
                <TextBlock Text="Password Vault"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />

                <!-- Status-Chip: Gesperrt / Entsperrt -->
                <Border x:Name="StateChip"
                        Style="{StaticResource ChipStyle}"
                        Padding="8,2"
                        CornerRadius="10">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Grid Width="8" Height="8" VerticalAlignment="Center">
                            <Ellipse x:Name="StateDotRipple" Fill="{StaticResource DangerBrush}" />
                            <Ellipse x:Name="StateDot" Fill="{StaticResource DangerBrush}" />
                        </Grid>
                        <TextBlock x:Name="StateText"
                                   Text="Gesperrt"
                                   FontSize="11"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Border>

                <!-- Browser-Bridge-Indikator -->
                <Border x:Name="BridgeChip"
                        Style="{StaticResource ChipStyle}"
                        Padding="8,2"
                        CornerRadius="10"
                        Visibility="Collapsed"
                        ToolTipService.ToolTip="Browser-Erweiterung kann sich verbinden" AutomationProperties.Name="Browser-Erweiterung kann sich verbinden">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE774;" FontSize="10"
                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock x:Name="BridgeText"
                                   Text="Browser"
                                   FontSize="11"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <!-- Toast-Benachrichtigung -->
        <Grid x:Name="ToastHost"
              Grid.RowSpan="2"
              VerticalAlignment="Bottom"
              HorizontalAlignment="Center"
              Margin="0,0,0,32"
              IsHitTestVisible="False">
            <Border x:Name="Toast"
                    Visibility="Collapsed"
                    MinWidth="280"
                    MaxWidth="520"
                    CornerRadius="16"
                    Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
                    BorderThickness="1">
                <Grid>
                    <StackPanel Orientation="Horizontal"
                                Spacing="12"
                                Padding="16,12,20,14">
                        <Border Width="28" Height="28"
                                CornerRadius="9"
                                Background="{StaticResource VaultGradientBrush}">
                            <FontIcon x:Name="ToastIcon"
                                      Glyph="&#xE73E;"
                                      FontSize="13"
                                      Foreground="White" />
                        </Border>
                        <TextBlock x:Name="ToastText"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap"
                                   MaxWidth="440" />
                    </StackPanel>
                    <Rectangle x:Name="ToastCountdown"
                               Height="3"
                               VerticalAlignment="Bottom"
                               Margin="14,0,14,4"
                               RadiusX="1.5" RadiusY="1.5"
                               Fill="{StaticResource VaultGradientBrush}"
                               Visibility="Collapsed" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
