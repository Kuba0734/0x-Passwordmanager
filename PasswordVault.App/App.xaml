<Application
    x:Class="PasswordVault.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Dark">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources
                    xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- ===== Design-Tokens (Gegenstück zu BrowserExtension/src/ui/tokens.css) =====
                 Monochrom: Akzent ist Weiß, Text darauf fast Schwarz. Die App läuft immer im dunklen Design. -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <!-- Systemakzent auf Weiß/Grau: färbt Schalter, Slider, Auswahl, Fokus usw. monochrom -->
                    <Color x:Key="SystemAccentColor">#FFFFFF</Color>
                    <Color x:Key="SystemAccentColorLight1">#FFFFFF</Color>
                    <Color x:Key="SystemAccentColorLight2">#F5F5F5</Color>
                    <Color x:Key="SystemAccentColorLight3">#E5E5E5</Color>
                    <Color x:Key="SystemAccentColorDark1">#D4D4D4</Color>
                    <Color x:Key="SystemAccentColorDark2">#A3A3A3</Color>
                    <Color x:Key="SystemAccentColorDark3">#737373</Color>

                    <!-- Glas: halbtransparente Flächen mit 1px-Rand rgba(255,255,255,0.08) -->
                    <SolidColorBrush x:Key="SurfaceBrush" Color="#0DFFFFFF" />
                    <SolidColorBrush x:Key="SurfaceStrongBrush" Color="#17FFFFFF" />
                    <SolidColorBrush x:Key="SurfaceStrokeBrush" Color="#14FFFFFF" />
                    <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#0DFFFFFF" />
                    <SolidColorBrush x:Key="CardBackgroundFillColorSecondaryBrush" Color="#08FFFFFF" />
                    <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#14FFFFFF" />
                    <SolidColorBrush x:Key="SurfaceStrokeColorDefaultBrush" Color="#14FFFFFF" />
                    <SolidColorBrush x:Key="SurfaceStrokeColorFlyoutBrush" Color="#14FFFFFF" />

                    <!-- Passwortzeichen ohne Farbe unterscheidbar: Ziffern gedämpft, Sonderzeichen hell -->
                    <SolidColorBrush x:Key="DigitBrush" Color="#A3A3A3" />
                    <SolidColorBrush x:Key="SymbolBrush" Color="#FFFFFF" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!-- Hintergrund: fast schwarz, lässt Mica nur leicht durchscheinen -->
            <SolidColorBrush x:Key="AppBackgroundBrush" Color="#EB050505" />

            <!-- Akzent und Text darauf -->
            <SolidColorBrush x:Key="AccentBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="OnAccentBrush" Color="#0A0A0A" />

            <!-- Glas für wenige, große Flächen (Karten-Container, Dialoge, Toast) -->
            <AcrylicBrush x:Key="GlassBrush"
                          TintColor="#141414"
                          TintOpacity="0.6"
                          FallbackColor="#F0141414" />

            <!-- Nur für Fehler, Löschen und Erfolg -->
            <SolidColorBrush x:Key="SuccessBrush" Color="#4ADE80" />
            <SolidColorBrush x:Key="DangerBrush" Color="#F87171" />
            <SolidColorBrush x:Key="DangerSurfaceBrush" Color="#1FF87171" />
            <SolidColorBrush x:Key="DangerStrokeBrush" Color="#59F87171" />

            <!-- Neutrale Hervorhebungen (früher farbig) -->
            <SolidColorBrush x:Key="WarningBrush" Color="#D4D4D4" />
            <SolidColorBrush x:Key="InfoBrush" Color="#A3A3A3" />
            <SolidColorBrush x:Key="FavoriteBrush" Color="#F5F5F5" />

            <!-- Schrift: Inter, lokal eingebunden -->
            <FontFamily x:Key="InterFont">ms-appx:///Assets/Fonts/InterVariable.ttf#Inter Variable</FontFamily>
            <FontFamily x:Key="ContentControlThemeFontFamily">ms-appx:///Assets/Fonts/InterVariable.ttf#Inter Variable</FontFamily>
            <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas</FontFamily>
            <Style TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource InterFont}" />
            </Style>

            <!-- Eingebaute Textstile mit Inter ersetzen (die Originale verweisen fest auf Segoe UI Variable) -->
            <Style x:Key="AppTextBlockBase" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource InterFont}" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                <Setter Property="TextLineBounds" Value="Full" />
            </Style>
            <Style x:Key="CaptionTextBlockStyle" TargetType="TextBlock" BasedOn="{StaticResource AppTextBlockBase}">
                <Setter Property="FontSize" Value="12" />
            </Style>
            <Style x:Key="BodyTextBlockStyle" TargetType="TextBlock" BasedOn="{StaticResource AppTextBlockBase}">
                <Setter Property="FontSize" Value="14" />
            </Style>
            <Style x:Key="BodyStrongTextBlockStyle" TargetType="TextBlock" BasedOn="{StaticResource AppTextBlockBase}">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>
            <Style x:Key="SubtitleTextBlockStyle" TargetType="TextBlock" BasedOn="{StaticResource AppTextBlockBase}">
                <Setter Property="FontSize" Value="20" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>
            <Style x:Key="TitleTextBlockStyle" TargetType="TextBlock" BasedOn="{StaticResource AppTextBlockBase}">
                <Setter Property="FontSize" Value="28" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>

            <!-- Radien -->
            <CornerRadius x:Key="ControlCornerRadius">8</CornerRadius>
            <CornerRadius x:Key="OverlayCornerRadius">14</CornerRadius>

            <!-- Bewegung: Standard-Easing cubic-bezier(0.22, 1, 0.36, 1) = KeySpline "0.22,1 0.36,1", 150–300 ms; Code-Animationen in Helpers\Motion.cs -->

            <!-- ===== Primär-Button: weiß, hebt sich bei Hover um 2px mit dezentem Glow, Klick 0.97 ===== -->
            <Style x:Key="PrimaryButtonStyle" TargetType="Button">
                <Setter Property="Foreground" Value="{StaticResource OnAccentBrush}" />
                <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Padding" Value="18,10" />
                <Setter Property="MinHeight" Value="40" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="UseSystemFocusVisuals" Value="True" />
                <Setter Property="FocusVisualMargin" Value="-3" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid x:Name="Root" RenderTransformOrigin="0.5,0.5">
                                <Grid.RenderTransform>
                                    <CompositeTransform x:Name="RootTransform" />
                                </Grid.RenderTransform>
                                <!-- Glow: zwei weiche Ringe, nur über Opacity eingeblendet -->
                                <Border x:Name="Glow" Opacity="0" Margin="-4"
                                        CornerRadius="14" BorderThickness="4" BorderBrush="#0FFFFFFF" />
                                <Border x:Name="GlowInner" Opacity="0" Margin="-1"
                                        CornerRadius="11" BorderThickness="1" BorderBrush="#33FFFFFF" />
                                <Border Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="{TemplateBinding CornerRadius}" />
                                <ContentPresenter x:Name="ContentPresenter"
                                                  Content="{TemplateBinding Content}"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                  ContentTransitions="{TemplateBinding ContentTransitions}"
                                                  Padding="{TemplateBinding Padding}"
                                                  Foreground="{TemplateBinding Foreground}"
                                                  HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                                  AutomationProperties.AccessibilityView="Raw" />
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal">
                                            <Storyboard>
                                                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RootTransform" Storyboard.TargetProperty="TranslateY">
                                                    <SplineDoubleKeyFrame KeyTime="0:0:0.2" Value="0" KeySpline="0.22,1 0.36,1" />
                                                </DoubleAnimationUsingKeyFrames>
                                                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RootTransform" Storyboard.TargetProperty="ScaleX">
                                                    <SplineDoubleKeyFrame KeyTime="0:0:0.2" Value="1" KeySpline="0.22,1 0.36,1" />
                                                </DoubleAnimationUsingKeyFrames>
                                                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RootTransform" Storyboard.TargetProperty="ScaleY">
                                                    <SplineDoubleKeyFrame KeyTime="0:0:0.2" Value="1" KeySpline="0.22,1 0.36,1" />
                                                </DoubleAnimationUsingKeyFrames>
                                                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Glow" Storyboard.TargetProperty="Opacity">
                                                    <SplineDoubleKeyFrame KeyTime="0:0:0.2" Value="0" KeySpline="0.22,1 0.36,1" />
                                                </DoubleAnimationUsingKeyFrames>
                                                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="GlowInner" Storyboard.TargetProperty="Opacity">
                                                    <SplineDoubleKeyFrame KeyTime="0:0:0.2" Value="0" KeySpline="0.22,1 0.36,1" />
                                                </DoubleAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="PointerOver">
                                            <Storyboard>
                                                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RootTransform" Storyboard.TargetProperty="TranslateY">
                                                    <SplineDoubleKeyFrame KeyTime="0:0:0.2" Value="-2" KeySpline="0.22,1 0.36,1" />
                                                </DoubleAnimationUsingKeyFrames>
                                                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Glow" Storyboard.TargetProperty="Opacity">
                                                    <SplineDoubleKeyFrame KeyTime="0:0:0.2" Value="1" KeySpline="0.22,1 0.36,1" />
                                                </DoubleAnimationUsingKeyFrames>
                                                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="GlowInner" Storyboard.TargetProperty="Opacity">
                                                    <SplineDoubleKeyFrame KeyTime="0:0:0.2" Value="1" KeySpline="0.22,1 0.36,1" />
                                                </DoubleAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <Storyboard>
                                                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RootTransform" Storyboard.TargetProperty="TranslateY">
                                                    <SplineDoubleKeyFrame KeyTime="0:0:0.15" Value="0" KeySpline="0.22,1 0.36,1" />
                                                </DoubleAnimationUsingKeyFrames>
                                                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RootTransform" Storyboard.TargetProperty="ScaleX">
                                                    <SplineDoubleKeyFrame KeyTime="0:0:0.15" Value="0.97" KeySpline="0.22,1 0.36,1" />
                                                </DoubleAnimationUsingKeyFrames>
                                                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RootTransform" Storyboard.TargetProperty="ScaleY">
                                                    <SplineDoubleKeyFrame KeyTime="0:0:0.15" Value="0.97" KeySpline="0.22,1 0.36,1" />
                                                </DoubleAnimationUsingKeyFrames>
                                                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Glow" Storyboard.TargetProperty="Opacity">
                                                    <SplineDoubleKeyFrame KeyTime="0:0:0.15" Value="0.5" KeySpline="0.22,1 0.36,1" />
                                                </DoubleAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <Storyboard>
                                                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Root" Storyboard.TargetProperty="Opacity">
                                                    <SplineDoubleKeyFrame KeyTime="0:0:0.15" Value="0.45" KeySpline="0.22,1 0.36,1" />
                                                </DoubleAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Sekundär: Glasfläche mit Rand, gleiche Bewegung -->
            <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                <Setter Property="Background" Value="{ThemeResource SurfaceStrongBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource SurfaceStrokeBrush}" />
                <Setter Property="BorderThickness" Value="1" />
            </Style>

            <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
                <Setter Property="Background" Value="{StaticResource DangerBrush}" />
            </Style>

            <!-- ===== Dezenter Icon-Button ===== -->
            <Style x:Key="IconButtonStyle" TargetType="Button">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Width" Value="36" />
                <Setter Property="Height" Value="36" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="UseSystemFocusVisuals" Value="True" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid x:Name="Root"
                                  Background="Transparent"
                                  RenderTransformOrigin="0.5,0.5"
                                  CornerRadius="{TemplateBinding CornerRadius}">
                                <Grid.RenderTransform>
                                    <CompositeTransform x:Name="RootTransform" />
                                </Grid.RenderTransform>
                                <Border x:Name="Fill"
                                        Background="{ThemeResource SurfaceStrongBrush}"
                                        BorderBrush="{ThemeResource SurfaceStrokeBrush}"
                                        BorderThickness="1"
                                        CornerRadius="{TemplateBinding CornerRadius}"
                                        Opacity="0" />
                                <ContentPresenter x:Name="ContentPresenter"
                                                  Content="{TemplateBinding Content}"
                                                  Padding="{TemplateBinding Padding}"
                                                  Foreground="{TemplateBinding Foreground}"
                                                  HorizontalContentAlignment="Center"
                                                  VerticalContentAlignment="Center" />
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal">
                                            <Storyboard>
                                                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Fill" Storyboard.TargetProperty="Opacity">
                                                    <SplineDoubleKeyFrame KeyTime="0:0:0.15" Value="0" KeySpline="0.22,1 0.36,1" />
                                                </DoubleAnimationUsingKeyFrames>
                                                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RootTransform" Storyboard.TargetProperty="TranslateY">
                                                    <SplineDoubleKeyFrame KeyTime="0:0:0.2" Value="0" KeySpline="0.22,1 0.36,1" />
                                                </DoubleAnimationUsingKeyFrames>
                                                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RootTransform" Storyboard.TargetProperty="ScaleX">
                                                    <SplineDoubleKeyFrame KeyTime="0:0:0.2" Value="1" KeySpline="0.22,1 0.36,1" />
                                                </DoubleAnimationUsingKeyFrames>
                                                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RootTransform" Storyboard.TargetProperty="ScaleY">
                                                    <SplineDoubleKeyFrame KeyTime="0:0:0.2" Value="1" KeySpline="0.22,1 0.36,1" />
                                                </DoubleAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="PointerOver">
                                            <Storyboard>
                                                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Fill" Storyboard.TargetProperty="Opacity">
                                                    <SplineDoubleKeyFrame KeyTime="0:0:0.15" Value="1" KeySpline="0.22,1 0.36,1" />
                                                </DoubleAnimationUsingKeyFrames>
                                                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RootTransform" Storyboard.TargetProperty="TranslateY">
                                                    <SplineDoubleKeyFrame KeyTime="0:0:0.2" Value="-2" KeySpline="0.22,1 0.36,1" />
                                                </DoubleAnimationUsingKeyFrames>
                                            </Storyboard>
                                            <VisualState.Setters>
                                                <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <Storyboard>
                                                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Fill" Storyboard.TargetProperty="Opacity">
                                                    <SplineDoubleKeyFrame KeyTime="0:0:0.15" Value="0.7" KeySpline="0.22,1 0.36,1" />
                                                </DoubleAnimationUsingKeyFrames>
                                                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RootTransform" Storyboard.TargetProperty="ScaleX">
                                                    <SplineDoubleKeyFrame KeyTime="0:0:0.15" Value="0.97" KeySpline="0.22,1 0.36,1" />
                                                </DoubleAnimationUsingKeyFrames>
                                                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RootTransform" Storyboard.TargetProperty="ScaleY">
                                                    <SplineDoubleKeyFrame KeyTime="0:0:0.15" Value="0.97" KeySpline="0.22,1 0.36,1" />
                                                </DoubleAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <VisualState.Setters>
                                                <Setter Target="Root.Opacity" Value="0.4" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ===== Karten & Chips ===== -->
            <Style x:Key="CardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource SurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource SurfaceStrokeBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="14" />
                <Setter Property="Padding" Value="20" />
            </Style>

            <!-- Glas mit Blur – nur für große Einzelflächen verwenden, nie für Listenelemente -->
            <Style x:Key="GlassCardStyle" TargetType="Border" BasedOn="{StaticResource CardStyle}">
                <Setter Property="Background" Value="{StaticResource GlassBrush}" />
                <Setter Property="CornerRadius" Value="18" />
            </Style>

            <!-- Akzent-Kachel für Seiten-Symbole (weiß, Symbol dunkel) -->
            <Style x:Key="AccentTileStyle" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                <Setter Property="CornerRadius" Value="12" />
            </Style>

            <Style x:Key="ChipStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource SurfaceStrongBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource SurfaceStrokeBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="8,3" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style x:Key="FieldLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}" />
                <Setter Property="CharacterSpacing" Value="60" />
            </Style>

            <Style x:Key="PageTitleStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource InterFont}" />
                <Setter Property="FontSize" Value="30" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="CharacterSpacing" Value="-20" />
            </Style>

            <Style x:Key="SectionTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
                <Setter Property="Margin" Value="2,28,0,10" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
