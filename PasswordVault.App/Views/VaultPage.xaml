<Page
    x:Class="PasswordVault.App.Views.VaultPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:PasswordVault.Core.Models"
    xmlns:helpers="using:PasswordVault.App.Helpers"
    Background="Transparent">

    <Page.Resources>
        <Style x:Key="EntryItemStyle" TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>

        <!-- Feld im Detailbereich (Label, Wert, Aktionen) -->
        <Style x:Key="DetailFieldStyle" TargetType="Grid">
            <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="16,12,8,12" />
            <Setter Property="ColumnSpacing" Value="4" />
        </Style>
    </Page.Resources>

    <Grid x:Name="LayoutRoot" Padding="32,20,32,24" ColumnSpacing="24" RowSpacing="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="320" />
            <ColumnDefinition x:Name="DetailColumn" Width="420" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ===== Kopfzeile ===== -->
        <Grid x:Name="Header" Grid.ColumnSpan="2" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="14">
                <Border Width="48" Height="48" CornerRadius="16"
                        Background="{StaticResource AccentBrush}">
                    <FontIcon x:Name="HeaderIcon" Glyph="&#xE8A9;" FontSize="20" Foreground="{StaticResource OnAccentBrush}" />
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="PageTitle" Text="Alle Einträge" Style="{StaticResource PageTitleStyle}" />
                    <TextBlock x:Name="PageSubtitle"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </StackPanel>
            <Button x:Name="NewButton"
                    Grid.Column="1"
                    Style="{StaticResource PrimaryButtonStyle}"
                    VerticalAlignment="Center"
                    Click="AddEntry_Click"
                    ToolTipService.ToolTip="Neuer Eintrag (Strg+N)" AutomationProperties.Name="Neuer Eintrag (Strg+N)">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE710;" FontSize="14" />
                    <TextBlock Text="Neuer Eintrag" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- ===== Suche & Sortierung ===== -->
        <Grid x:Name="Toolbar" Grid.Row="1" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <AutoSuggestBox x:Name="SearchBox"
                            PlaceholderText="Suchen …  (Strg+F)"
                            AutomationProperties.Name="Suchen"
                            QueryIcon="Find"
                            CornerRadius="12"
                            TextChanged="SearchBox_TextChanged" />
            <ComboBox x:Name="SortBox"
                      Grid.Column="1"
                      MinWidth="170"
                      CornerRadius="12"
                      SelectedIndex="0"
                      SelectionChanged="SortBox_SelectionChanged">
                <ComboBoxItem Content="Name (A–Z)" Tag="name" />
                <ComboBoxItem Content="Zuletzt geändert" Tag="modified" />
                <ComboBoxItem Content="Neueste zuerst" Tag="created" />
            </ComboBox>
        </Grid>

        <!-- ===== Liste ===== -->
        <ListView x:Name="EntryList"
                  Grid.Row="2"
                  Margin="-8,0,-8,0"
                  Padding="8,0,8,24"
                  SelectionMode="Single"
                  ItemContainerStyle="{StaticResource EntryItemStyle}"
                  SelectionChanged="EntryList_SelectionChanged"
                  IsItemClickEnabled="False">
            <ListView.ItemContainerTransitions>
                <TransitionCollection>
                    <EntranceThemeTransition IsStaggeringEnabled="True" FromVerticalOffset="40" />
                    <AddDeleteThemeTransition />
                    <RepositionThemeTransition />
                    <ContentThemeTransition />
                </TransitionCollection>
            </ListView.ItemContainerTransitions>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:PasswordEntry">
                    <Grid Padding="12,10" ColumnSpacing="14"
                          Background="Transparent"
                          helpers:Motion.HoverRevealTarget="{Binding ElementName=QuickActions}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Width="44" Height="44" CornerRadius="14"
                                Background="{x:Bind helpers:Ui.AvatarBrush(Title)}">
                            <TextBlock Text="{x:Bind helpers:Ui.Initial(Title)}"
                                       Foreground="White"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="{x:Bind Title}"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" />
                                <FontIcon Glyph="&#xE735;" FontSize="12"
                                          Foreground="{StaticResource FavoriteBrush}"
                                          Visibility="{x:Bind helpers:Ui.Visible(IsFavorite)}" />
                            </StackPanel>
                            <TextBlock Text="{x:Bind helpers:Ui.Subtitle(Username, Url)}"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <Grid Grid.Column="2">
                            <Border Style="{StaticResource ChipStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="{x:Bind helpers:Ui.CategoryGlyph(Category)}" FontSize="11"
                                              Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="{x:Bind Category}" FontSize="11"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </Border>
                            <StackPanel x:Name="QuickActions"
                                        Orientation="Horizontal"
                                        Spacing="2"
                                        Padding="4,0,0,0"
                                        Background="{ThemeResource SolidBackgroundFillColorTertiaryBrush}"
                                        CornerRadius="10"
                                        HorizontalAlignment="Right">
                                <Button Style="{StaticResource IconButtonStyle}"
                                        Tag="{x:Bind Id}"
                                        Click="QuickCopyUser_Click"
                                        ToolTipService.ToolTip="Benutzername kopieren" AutomationProperties.Name="Benutzername kopieren">
                                    <FontIcon Glyph="&#xE77B;" FontSize="14" />
                                </Button>
                                <Button Style="{StaticResource IconButtonStyle}"
                                        Tag="{x:Bind Id}"
                                        Click="QuickCopyPassword_Click"
                                        ToolTipService.ToolTip="Passwort kopieren" AutomationProperties.Name="Passwort kopieren">
                                    <FontIcon Glyph="&#xE8C8;" FontSize="14" />
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- ===== Leerer Zustand ===== -->
        <StackPanel x:Name="EmptyState"
                    Grid.Row="2"
                    Spacing="10"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Visibility="Collapsed"
                    Margin="0,0,0,60">
            <Grid x:Name="EmptyIllustration" Width="120" Height="120" HorizontalAlignment="Center">
                <Ellipse Fill="{StaticResource AccentBrush}" Opacity="0.04" />
                <Ellipse Fill="{StaticResource AccentBrush}" Opacity="0.08" Margin="18" />
                <Border Width="56" Height="56" CornerRadius="18"
                        Background="{StaticResource AccentBrush}">
                    <FontIcon x:Name="EmptyIcon" Glyph="&#xE72E;" FontSize="24" Foreground="{StaticResource OnAccentBrush}" />
                </Border>
            </Grid>
            <TextBlock x:Name="EmptyTitle"
                       Text="Noch keine Einträge"
                       Style="{StaticResource SubtitleTextBlockStyle}"
                       HorizontalAlignment="Center" />
            <TextBlock x:Name="EmptyText"
                       Text="Füge deinen ersten Zugang hinzu – er wird sofort verschlüsselt gespeichert."
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       MaxWidth="320" />
            <Button x:Name="EmptyAddButton"
                    Style="{StaticResource PrimaryButtonStyle}"
                    HorizontalAlignment="Center"
                    Margin="0,8,0,0"
                    Click="AddEntry_Click"
                    Content="Ersten Eintrag anlegen" />
        </StackPanel>

        <!-- ===== Detailbereich ===== -->
        <Border x:Name="DetailCard"
                Grid.Row="1" Grid.RowSpan="2" Grid.Column="1"
                Style="{StaticResource CardStyle}"
                CornerRadius="22"
                Padding="0">
            <Grid>
                <!-- Platzhalter -->
                <StackPanel x:Name="DetailPlaceholder"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Spacing="10"
                            Padding="24">
                    <FontIcon Glyph="&#xE8A1;" FontSize="40"
                              Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    <TextBlock Text="Wähle einen Eintrag aus"
                               Style="{StaticResource BodyStrongTextBlockStyle}"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="Details, Passwortstärke und Schnellaktionen erscheinen hier."
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               MaxWidth="240" />
                </StackPanel>

                <ScrollViewer x:Name="DetailScroller" Visibility="Collapsed">
                    <StackPanel x:Name="DetailPanel" Padding="24,24,24,24" Spacing="12">

                        <!-- Zurück (nur im schmalen Layout) -->
                        <Button x:Name="DetailBackButton"
                                Style="{StaticResource IconButtonStyle}"
                                Visibility="Collapsed"
                                Click="DetailBack_Click"
                                ToolTipService.ToolTip="Zurück zur Liste" AutomationProperties.Name="Zurück zur Liste">
                            <FontIcon Glyph="&#xE72B;" FontSize="14" />
                        </Button>

                        <!-- Kopf -->
                        <Grid ColumnSpacing="16" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="DetailAvatar" Width="64" Height="64" CornerRadius="20">
                                <TextBlock x:Name="DetailInitial"
                                           Foreground="White" FontSize="26" FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock x:Name="DetailTitle"
                                           Style="{StaticResource SubtitleTextBlockStyle}"
                                           TextWrapping="Wrap" />
                                <TextBlock x:Name="DetailHost"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <Button x:Name="FavoriteButton"
                                    Grid.Column="2"
                                    Style="{StaticResource IconButtonStyle}"
                                    VerticalAlignment="Top"
                                    Click="Favorite_Click"
                                    ToolTipService.ToolTip="Favorit" AutomationProperties.Name="Favorit">
                                <FontIcon x:Name="FavoriteIcon" Glyph="&#xE734;" FontSize="18" />
                            </Button>
                        </Grid>

                        <!-- Benutzername -->
                        <Grid x:Name="UserField" Style="{StaticResource DetailFieldStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock x:Name="UserLabel" Text="BENUTZERNAME" Style="{StaticResource FieldLabelStyle}" />
                                <TextBlock x:Name="DetailUser" IsTextSelectionEnabled="True" TextWrapping="Wrap" />
                            </StackPanel>
                            <Button Grid.Column="1" Style="{StaticResource IconButtonStyle}"
                                    VerticalAlignment="Center"
                                    Click="CopyUser_Click" ToolTipService.ToolTip="Kopieren" AutomationProperties.Name="Kopieren">
                                <FontIcon Glyph="&#xE8C8;" FontSize="14" />
                            </Button>
                        </Grid>

                        <!-- Passwort -->
                        <Grid x:Name="PasswordField" Style="{StaticResource DetailFieldStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="4">
                                <TextBlock x:Name="PasswordLabel" Text="PASSWORT" Style="{StaticResource FieldLabelStyle}" />
                                <TextBlock x:Name="DetailPassword"
                                           FontFamily="{StaticResource MonoFont}"
                                           FontSize="15"
                                           TextWrapping="Wrap"
                                           IsTextSelectionEnabled="True" />
                            </StackPanel>
                            <Button x:Name="RevealButton" Grid.Column="1"
                                    Style="{StaticResource IconButtonStyle}"
                                    VerticalAlignment="Center"
                                    Click="Reveal_Click" ToolTipService.ToolTip="Anzeigen" AutomationProperties.Name="Anzeigen">
                                <FontIcon x:Name="RevealIcon" Glyph="&#xE7B3;" FontSize="14" />
                            </Button>
                            <Button Grid.Column="2" Style="{StaticResource IconButtonStyle}"
                                    VerticalAlignment="Center"
                                    Click="CopyPassword_Click" ToolTipService.ToolTip="Kopieren" AutomationProperties.Name="Kopieren">
                                <FontIcon Glyph="&#xE8C8;" FontSize="14" />
                            </Button>
                        </Grid>

                        <!-- Stärke -->
                        <StackPanel x:Name="StrengthPanel" Spacing="8" Padding="4,0">
                            <Grid>
                                <TextBlock x:Name="StrengthLabel" Style="{StaticResource CaptionTextBlockStyle}" FontWeight="SemiBold" />
                                <TextBlock x:Name="StrengthDetail" HorizontalAlignment="Right"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            </Grid>
                            <Grid Height="6">
                                <Border CornerRadius="3" Background="{ThemeResource SubtleFillColorSecondaryBrush}" />
                                <Border x:Name="StrengthFill" CornerRadius="3" />
                            </Grid>
                        </StackPanel>

                        <!-- Kreditkarte: Ablaufdatum + CVC -->
                        <Grid x:Name="CardField" Style="{StaticResource DetailFieldStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="4">
                                <TextBlock Text="GÜLTIG BIS" Style="{StaticResource FieldLabelStyle}" />
                                <TextBlock x:Name="DetailExpiry" FontFamily="{StaticResource MonoFont}" FontSize="15" IsTextSelectionEnabled="True" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="4">
                                <TextBlock Text="CVC" Style="{StaticResource FieldLabelStyle}" />
                                <TextBlock x:Name="DetailCvc" FontFamily="{StaticResource MonoFont}" FontSize="15" IsTextSelectionEnabled="True" />
                            </StackPanel>
                            <Button Grid.Column="2" Style="{StaticResource IconButtonStyle}"
                                    VerticalAlignment="Center"
                                    Click="CopyCvc_Click" ToolTipService.ToolTip="CVC kopieren" AutomationProperties.Name="CVC kopieren">
                                <FontIcon Glyph="&#xE8C8;" FontSize="14" />
                            </Button>
                        </Grid>

                        <!-- Website -->
                        <Grid x:Name="UrlField" Style="{StaticResource DetailFieldStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock Text="WEBSITE" Style="{StaticResource FieldLabelStyle}" />
                                <TextBlock x:Name="DetailUrl" TextTrimming="CharacterEllipsis" IsTextSelectionEnabled="True" />
                            </StackPanel>
                            <Button Grid.Column="1" Style="{StaticResource IconButtonStyle}"
                                    VerticalAlignment="Center"
                                    Click="OpenUrl_Click" ToolTipService.ToolTip="Im Browser öffnen" AutomationProperties.Name="Im Browser öffnen">
                                <FontIcon Glyph="&#xE8A7;" FontSize="14" />
                            </Button>
                            <Button Grid.Column="2" Style="{StaticResource IconButtonStyle}"
                                    VerticalAlignment="Center"
                                    Click="CopyUrl_Click" ToolTipService.ToolTip="Kopieren" AutomationProperties.Name="Kopieren">
                                <FontIcon Glyph="&#xE8C8;" FontSize="14" />
                            </Button>
                        </Grid>

                        <!-- Notizen -->
                        <Grid x:Name="NotesField" Style="{StaticResource DetailFieldStyle}">
                            <StackPanel Spacing="4">
                                <TextBlock Text="NOTIZEN" Style="{StaticResource FieldLabelStyle}" />
                                <TextBlock x:Name="DetailNotes" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                            </StackPanel>
                        </Grid>

                        <!-- Meta -->
                        <StackPanel x:Name="MetaPanel" Orientation="Horizontal" Spacing="8" Padding="4,4,0,0">
                            <Border Style="{StaticResource ChipStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon x:Name="DetailCategoryIcon" FontSize="11" />
                                    <TextBlock x:Name="DetailCategory" FontSize="11" />
                                </StackPanel>
                            </Border>
                            <TextBlock x:Name="DetailMeta"
                                       VerticalAlignment="Center"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        </StackPanel>

                        <!-- Aktionen -->
                        <Grid x:Name="ActionRow" ColumnSpacing="10" Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button Style="{StaticResource PrimaryButtonStyle}"
                                    HorizontalAlignment="Stretch"
                                    Click="Edit_Click" AutomationProperties.Name="Bearbeiten">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE70F;" FontSize="14" />
                                    <TextBlock Text="Bearbeiten" />
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="1"
                                    MinHeight="40"
                                    CornerRadius="12"
                                    Padding="14,0"
                                    Click="Delete_Click"
                                    ToolTipService.ToolTip="Löschen" AutomationProperties.Name="Löschen">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE74D;" FontSize="14" Foreground="{StaticResource DangerBrush}" />
                                    <TextBlock Text="Löschen" Foreground="{StaticResource DangerBrush}" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Page>
