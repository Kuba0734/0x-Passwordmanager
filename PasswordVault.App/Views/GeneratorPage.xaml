<Page
    x:Class="PasswordVault.App.Views.GeneratorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="using:PasswordVault.App.Helpers"
    Background="Transparent">

    <ScrollViewer>
        <StackPanel x:Name="Root" Padding="32,20,32,40" Spacing="18" MaxWidth="980" HorizontalAlignment="Stretch">

            <StackPanel Orientation="Horizontal" Spacing="14">
                <Border Width="48" Height="48" CornerRadius="16" Background="{StaticResource AccentBrush}">
                    <FontIcon Glyph="&#xE8B1;" FontSize="20" Foreground="{StaticResource OnAccentBrush}" />
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Passwort-Generator" Style="{StaticResource PageTitleStyle}" />
                    <TextBlock Text="Kryptografisch zufällige Passwörter – lokal erzeugt, nie übertragen."
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </StackPanel>

            <!-- Ergebnis -->
            <Border x:Name="ResultCard" Style="{StaticResource CardStyle}" CornerRadius="22" Padding="28,26">
                <StackPanel Spacing="18">
                    <TextBlock x:Name="PasswordText"
                               FontFamily="{StaticResource MonoFont}"
                               FontSize="28"
                               TextWrapping="Wrap"
                               IsTextSelectionEnabled="True"
                               MinHeight="40" />
                    <StackPanel Spacing="8">
                        <Grid>
                            <TextBlock x:Name="StrengthLabel" FontWeight="SemiBold" />
                            <TextBlock x:Name="EntropyLabel"
                                       HorizontalAlignment="Right"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Grid>
                        <Grid Height="8">
                            <Border CornerRadius="4" Background="{ThemeResource SubtleFillColorSecondaryBrush}" />
                            <Border x:Name="StrengthFill" CornerRadius="4" />
                        </Grid>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button Style="{StaticResource PrimaryButtonStyle}" Click="Regenerate_Click" AutomationProperties.Name="Neu generieren">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon x:Name="RegenerateIcon" Glyph="&#xE72C;" FontSize="14" />
                                <TextBlock Text="Neu generieren" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="CopyButton" MinHeight="40" CornerRadius="12" Padding="16,0" Click="Copy_Click" AutomationProperties.Name="Kopieren">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE8C8;" FontSize="14" />
                                <TextBlock Text="Kopieren" />
                            </StackPanel>
                        </Button>
                        <Button MinHeight="40" CornerRadius="12" Padding="16,0" Click="SaveAsEntry_Click" AutomationProperties.Name="Als Eintrag speichern">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE710;" FontSize="14" />
                                <TextBlock Text="Als Eintrag speichern" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Grid ColumnSpacing="18" x:Name="LowerGrid">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Optionen -->
                <Border x:Name="OptionsCard" Style="{StaticResource CardStyle}" CornerRadius="22">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Optionen" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <Grid>
                            <TextBlock Text="Länge" VerticalAlignment="Center" />
                            <Border Style="{StaticResource ChipStyle}" HorizontalAlignment="Right">
                                <TextBlock x:Name="LengthValue" FontWeight="SemiBold" />
                            </Border>
                        </Grid>
                        <Slider x:Name="LengthSlider" Minimum="6" Maximum="64" StepFrequency="1"
                                ValueChanged="Option_Changed" />
                        <ToggleSwitch x:Name="UpperToggle" Header="Großbuchstaben (A–Z)" OnContent="" OffContent="" Toggled="Option_Changed" />
                        <ToggleSwitch x:Name="LowerToggle" Header="Kleinbuchstaben (a–z)" OnContent="" OffContent="" Toggled="Option_Changed" />
                        <ToggleSwitch x:Name="DigitToggle" Header="Ziffern (0–9)" OnContent="" OffContent="" Toggled="Option_Changed" />
                        <ToggleSwitch x:Name="SymbolToggle" Header="Sonderzeichen (!@#$ …)" OnContent="" OffContent="" Toggled="Option_Changed" />
                        <ToggleSwitch x:Name="AmbiguousToggle" Header="Verwechselbare Zeichen meiden (l, 1, O, 0 …)" OnContent="" OffContent="" Toggled="Option_Changed" />
                        <HyperlinkButton Content="Als Standard für neue Einträge speichern" Click="SaveDefaults_Click" Padding="0,4" />
                    </StackPanel>
                </Border>

                <!-- Verlauf -->
                <Border x:Name="HistoryCard" Grid.Column="1" Style="{StaticResource CardStyle}" CornerRadius="22">
                    <StackPanel Spacing="10">
                        <Grid>
                            <TextBlock Text="Verlauf (diese Sitzung)" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock Text="wird beim Sperren gelöscht"
                                       HorizontalAlignment="Right"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        </Grid>
                        <ListView x:Name="HistoryList" SelectionMode="None" MaxHeight="420">
                            <ListView.ItemContainerTransitions>
                                <TransitionCollection>
                                    <AddDeleteThemeTransition />
                                    <RepositionThemeTransition />
                                </TransitionCollection>
                            </ListView.ItemContainerTransitions>
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                                    <Setter Property="Padding" Value="8,4" />
                                    <Setter Property="CornerRadius" Value="10" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{x:Bind}"
                                                   FontFamily="{StaticResource MonoFont}"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" />
                                        <Button Grid.Column="1" Style="{StaticResource IconButtonStyle}"
                                                Tag="{x:Bind}" Click="CopyHistory_Click"
                                                ToolTipService.ToolTip="Kopieren" AutomationProperties.Name="Kopieren">
                                            <FontIcon Glyph="&#xE8C8;" FontSize="13" />
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
