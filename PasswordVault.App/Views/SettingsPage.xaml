<Page
    x:Class="PasswordVault.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:tk="using:CommunityToolkit.WinUI.Controls"
    Background="Transparent">

    <Page.Resources>
        <Style TargetType="tk:SettingsCard">
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <Style TargetType="tk:SettingsExpander">
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
    </Page.Resources>

    <ScrollViewer>
        <StackPanel x:Name="Root" Padding="32,20,32,48" MaxWidth="920" Spacing="0">

            <StackPanel Orientation="Horizontal" Spacing="14" Margin="0,0,0,8">
                <Border Width="48" Height="48" CornerRadius="16" Background="{StaticResource AccentBrush}">
                    <FontIcon Glyph="&#xE713;" FontSize="20" Foreground="{StaticResource OnAccentBrush}" />
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Einstellungen" Style="{StaticResource PageTitleStyle}" />
                    <TextBlock Text="Sicherheit, Browser-Erweiterung, Darstellung und Daten"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </StackPanel>

            <!-- ===== Sicherheit ===== -->
            <TextBlock Text="Sicherheit" Style="{StaticResource SectionTitleStyle}" />

            <tk:SettingsCard Header="Automatisch sperren"
                             Description="Sperrt den Tresor nach Inaktivität in der App.">
                <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE72E;" /></tk:SettingsCard.HeaderIcon>
                <ComboBox x:Name="AutoLockCombo" MinWidth="170" SelectionChanged="AutoLock_Changed">
                    <ComboBoxItem Content="Nach 1 Minute" Tag="60" />
                    <ComboBoxItem Content="Nach 5 Minuten" Tag="300" />
                    <ComboBoxItem Content="Nach 15 Minuten" Tag="900" />
                    <ComboBoxItem Content="Nach 30 Minuten" Tag="1800" />
                    <ComboBoxItem Content="Nach 1 Stunde" Tag="3600" />
                    <ComboBoxItem Content="Nie" Tag="0" />
                </ComboBox>
            </tk:SettingsCard>

            <tk:SettingsCard Header="Zwischenablage leeren"
                             Description="Kopierte Passwörter werden automatisch wieder entfernt und nicht im Windows-Verlauf gespeichert.">
                <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE77F;" /></tk:SettingsCard.HeaderIcon>
                <ComboBox x:Name="ClipboardCombo" MinWidth="170" SelectionChanged="Clipboard_Changed">
                    <ComboBoxItem Content="Nach 10 Sekunden" Tag="10" />
                    <ComboBoxItem Content="Nach 15 Sekunden" Tag="15" />
                    <ComboBoxItem Content="Nach 30 Sekunden" Tag="30" />
                    <ComboBoxItem Content="Nach 60 Sekunden" Tag="60" />
                    <ComboBoxItem Content="Nach 2 Minuten" Tag="120" />
                </ComboBox>
            </tk:SettingsCard>

            <tk:SettingsCard x:Name="WindowsHelloCard"
                             Header="Windows Hello"
                             Description="Tresor mit PIN, Fingerabdruck oder Gesichtserkennung entsperren."
                             Visibility="Collapsed">
                <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xEB68;" /></tk:SettingsCard.HeaderIcon>
                <ToggleSwitch x:Name="WindowsHelloToggle" Toggled="WindowsHello_Toggled" />
            </tk:SettingsCard>

            <tk:SettingsCard Header="Master-Passwort ändern"
                             Description="Verschlüsselt den gesamten Tresor mit einem neuen Schlüssel."
                             IsClickEnabled="True"
                             Click="ChangeMasterPassword_Click">
                <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE8D7;" /></tk:SettingsCard.HeaderIcon>
            </tk:SettingsCard>

            <!-- ===== Browser-Erweiterung ===== -->
            <TextBlock Text="Browser-Erweiterung" Style="{StaticResource SectionTitleStyle}" />

            <tk:SettingsExpander x:Name="BridgeExpander"
                                 Header="Verbindung zum Browser"
                                 Description="Erlaubt der Erweiterung, Logins auszufüllen und neue zu speichern."
                                 IsExpanded="True">
                <tk:SettingsExpander.HeaderIcon><FontIcon Glyph="&#xE774;" /></tk:SettingsExpander.HeaderIcon>
                <ToggleSwitch x:Name="BridgeToggle" Toggled="Bridge_Toggled" />
                <tk:SettingsExpander.Items>
                    <tk:SettingsCard Header="Status">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Ellipse x:Name="BridgeStatusDot" Width="8" Height="8" VerticalAlignment="Center" />
                            <TextBlock x:Name="BridgeStatusText" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="360" />
                        </StackPanel>
                    </tk:SettingsCard>
                    <tk:SettingsCard x:Name="PairingCard" Header="Gekoppelte Browser">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock x:Name="PairingText" VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <Button x:Name="UnpairButton" Content="Kopplung aufheben" Click="Unpair_Click" />
                        </StackPanel>
                    </tk:SettingsCard>
                    <tk:SettingsCard Header="Erweiterung installieren"
                                     Description="Chrome, Edge, Brave, Opera (GX) und andere Chromium-Browser.">
                        <Button Style="{StaticResource PrimaryButtonStyle}" Click="InstallExtension_Click" AutomationProperties.Name="Erweiterung einrichten">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE896;" FontSize="14" />
                                <TextBlock Text="Einrichten" />
                            </StackPanel>
                        </Button>
                    </tk:SettingsCard>
                </tk:SettingsExpander.Items>
            </tk:SettingsExpander>

            <!-- ===== Start & Infobereich ===== -->
            <TextBlock Text="Start &amp; Infobereich" Style="{StaticResource SectionTitleStyle}" />

            <tk:SettingsCard x:Name="AutostartCard"
                             Header="Mit Windows starten">
                <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE7E8;" /></tk:SettingsCard.HeaderIcon>
                <ToggleSwitch x:Name="AutostartToggle" Toggled="Autostart_Toggled" AutomationProperties.Name="Mit Windows starten" />
            </tk:SettingsCard>

            <tk:SettingsCard Header="Beim Minimieren in den Infobereich"
                             Description="Minimieren blendet das Fenster aus – ein Klick auf das Symbol neben der Uhr öffnet es wieder. Beenden über Rechtsklick auf das Symbol.">
                <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE921;" /></tk:SettingsCard.HeaderIcon>
                <ToggleSwitch x:Name="MinimizeToTrayToggle" Toggled="MinimizeToTray_Toggled" AutomationProperties.Name="Beim Minimieren in den Infobereich" />
            </tk:SettingsCard>

            <!-- ===== Generator ===== -->
            <TextBlock Text="Passwort-Generator" Style="{StaticResource SectionTitleStyle}" />

            <tk:SettingsExpander Header="Standard für neue Passwörter"
                                 Description="Wird im Eintrags-Dialog, im Generator und von der Browser-Erweiterung verwendet.">
                <tk:SettingsExpander.HeaderIcon><FontIcon Glyph="&#xE8B1;" /></tk:SettingsExpander.HeaderIcon>
                <TextBlock x:Name="GeneratorSummary" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <tk:SettingsExpander.Items>
                    <tk:SettingsCard Header="Länge">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Slider x:Name="LengthSlider" Width="200" Minimum="8" Maximum="64"
                                    StepFrequency="1" ValueChanged="Generator_Changed" />
                            <TextBlock x:Name="LengthValue" VerticalAlignment="Center" MinWidth="24" FontWeight="SemiBold" />
                        </StackPanel>
                    </tk:SettingsCard>
                    <tk:SettingsCard Header="Großbuchstaben (A–Z)">
                        <ToggleSwitch x:Name="UpperToggle" Toggled="Generator_Changed" />
                    </tk:SettingsCard>
                    <tk:SettingsCard Header="Kleinbuchstaben (a–z)">
                        <ToggleSwitch x:Name="LowerToggle" Toggled="Generator_Changed" />
                    </tk:SettingsCard>
                    <tk:SettingsCard Header="Ziffern (0–9)">
                        <ToggleSwitch x:Name="DigitToggle" Toggled="Generator_Changed" />
                    </tk:SettingsCard>
                    <tk:SettingsCard Header="Sonderzeichen">
                        <ToggleSwitch x:Name="SymbolToggle" Toggled="Generator_Changed" />
                    </tk:SettingsCard>
                    <tk:SettingsCard Header="Verwechselbare Zeichen meiden" Description="l, I, 1, O, 0, o, |">
                        <ToggleSwitch x:Name="AmbiguousToggle" Toggled="Generator_Changed" />
                    </tk:SettingsCard>
                </tk:SettingsExpander.Items>
            </tk:SettingsExpander>

            <!-- ===== Darstellung ===== -->
            <TextBlock Text="Darstellung" Style="{StaticResource SectionTitleStyle}" />



            <tk:SettingsCard Header="Animationen"
                             Description="Bewegungseffekte in der gesamten App. Wird automatisch reduziert, wenn Windows-Animationen aus sind.">
                <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE945;" /></tk:SettingsCard.HeaderIcon>
                <ToggleSwitch x:Name="AnimationsToggle" Toggled="Animations_Toggled" />
            </tk:SettingsCard>

            <!-- ===== Daten ===== -->
            <TextBlock Text="Daten" Style="{StaticResource SectionTitleStyle}" />

            <tk:SettingsCard Header="Importieren"
                             Description="CSV aus Chrome, Edge, Firefox, Bitwarden, 1Password, KeePass oder Password Vault."
                             IsClickEnabled="True"
                             Click="ImportCsv_Click">
                <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE8B5;" /></tk:SettingsCard.HeaderIcon>
            </tk:SettingsCard>

            <tk:SettingsCard Header="Als CSV exportieren"
                             Description="Achtung: Die Datei ist NICHT verschlüsselt."
                             IsClickEnabled="True"
                             Click="ExportCsv_Click">
                <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xEDE1;" /></tk:SettingsCard.HeaderIcon>
            </tk:SettingsCard>

            <tk:SettingsCard Header="Verschlüsseltes Backup erstellen"
                             Description="Kopie der Tresor-Datei – nur mit deinem Master-Passwort lesbar."
                             IsClickEnabled="True"
                             Click="Backup_Click">
                <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE8F1;" /></tk:SettingsCard.HeaderIcon>
            </tk:SettingsCard>

            <tk:SettingsCard Header="Speicherort">
                <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE8B7;" /></tk:SettingsCard.HeaderIcon>
                <tk:SettingsCard.Description>
                    <TextBlock x:Name="VaultPathText" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                </tk:SettingsCard.Description>
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Button Style="{StaticResource IconButtonStyle}" Click="CopyVaultPath_Click" ToolTipService.ToolTip="Pfad kopieren" AutomationProperties.Name="Pfad kopieren">
                        <FontIcon Glyph="&#xE8C8;" FontSize="14" />
                    </Button>
                    <Button Style="{StaticResource IconButtonStyle}" Click="OpenVaultFolder_Click" ToolTipService.ToolTip="Ordner öffnen" AutomationProperties.Name="Ordner öffnen">
                        <FontIcon Glyph="&#xE838;" FontSize="14" />
                    </Button>
                </StackPanel>
            </tk:SettingsCard>

            <!-- ===== Über ===== -->
            <TextBlock Text="Über" Style="{StaticResource SectionTitleStyle}" />
            <tk:SettingsCard x:Name="UpdateCard" Header="Version">
                <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE895;" /></tk:SettingsCard.HeaderIcon>
                <Button x:Name="UpdateButton" Content="Nach Updates suchen" Click="CheckUpdates_Click" />
            </tk:SettingsCard>
            <tk:SettingsCard Header="Password Vault"
                             Description="AES-256-GCM · Argon2id (64 MB, 4 Iterationen) · Daten verlassen nie deinen PC.">
                <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE946;" /></tk:SettingsCard.HeaderIcon>
                <TextBlock Text="Strg+N  Neu · Strg+F  Suchen · Strg+G  Generator · Strg+L  Sperren"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
            </tk:SettingsCard>
        </StackPanel>
    </ScrollViewer>
</Page>
