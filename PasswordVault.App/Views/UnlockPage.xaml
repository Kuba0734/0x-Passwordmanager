<Page
    x:Class="PasswordVault.App.Views.UnlockPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">

    <Grid x:Name="Root">

        <!-- ===== Animierter Hintergrund: schwebende Farbwolken ===== -->
        <Grid IsHitTestVisible="False" Opacity="{ThemeResource BlobOpacity}">
            <Rectangle x:Name="BlobA" Width="620" Height="620"
                     HorizontalAlignment="Left" VerticalAlignment="Top"
                     Margin="-200,-220,0,0">
                <Rectangle.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#B07C5CFF" Offset="0" />
                        <GradientStop Color="#007C5CFF" Offset="1" />
                    </RadialGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <Rectangle x:Name="BlobB" Width="680" Height="680"
                     HorizontalAlignment="Right" VerticalAlignment="Bottom"
                     Margin="0,0,-240,-260">
                <Rectangle.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#9006B6D4" Offset="0" />
                        <GradientStop Color="#0006B6D4" Offset="1" />
                    </RadialGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <Rectangle x:Name="BlobC" Width="420" Height="420"
                     HorizontalAlignment="Right" VerticalAlignment="Top"
                     Margin="0,40,120,0">
                <Rectangle.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#70EC4899" Offset="0" />
                        <GradientStop Color="#00EC4899" Offset="1" />
                    </RadialGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <Rectangle x:Name="BlobD" Width="360" Height="360"
                     HorizontalAlignment="Left" VerticalAlignment="Bottom"
                     Margin="140,0,0,60">
                <Rectangle.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#606366F1" Offset="0" />
                        <GradientStop Color="#006366F1" Offset="1" />
                    </RadialGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
        </Grid>

        <!-- ===== Glas-Karte ===== -->
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Grid MinHeight="{Binding ElementName=Root, Path=ActualHeight}">
                <Border x:Name="Card"
                        Width="440"
                        Margin="24,72,24,40"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        CornerRadius="28"
                        Padding="40,36,40,30"
                        Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource SurfaceStrokeColorFlyoutBrush}"
                        BorderThickness="1">

                    <StackPanel x:Name="Form" Spacing="16">

                        <!-- Logo mit pulsierenden Ringen -->
                        <Grid Width="112" Height="112"
                              HorizontalAlignment="Center"
                              Margin="0,0,0,6">
                            <Ellipse x:Name="Ring1" StrokeThickness="2" Width="88" Height="88">
                                <Ellipse.Stroke>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#8B5CF6" Offset="0" />
                                        <GradientStop Color="#06B6D4" Offset="1" />
                                    </LinearGradientBrush>
                                </Ellipse.Stroke>
                            </Ellipse>
                            <Ellipse x:Name="Ring2" StrokeThickness="2" Width="88" Height="88">
                                <Ellipse.Stroke>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#EC4899" Offset="0" />
                                        <GradientStop Color="#8B5CF6" Offset="1" />
                                    </LinearGradientBrush>
                                </Ellipse.Stroke>
                            </Ellipse>
                            <Border x:Name="LogoTile"
                                    Width="88" Height="88"
                                    CornerRadius="30"
                                    Background="{StaticResource VaultGradientBrush}">
                                <FontIcon x:Name="LockIcon"
                                          Glyph="&#xE72E;"
                                          FontSize="38"
                                          Foreground="White" />
                            </Border>
                        </Grid>

                        <StackPanel Spacing="6">
                            <TextBlock x:Name="TitleText"
                                       Text="Willkommen zurück"
                                       FontSize="26"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center" />
                            <TextBlock x:Name="SubtitleText"
                                       Text="Gib dein Master-Passwort ein, um den Tresor zu öffnen."
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <PasswordBox x:Name="MasterPasswordBox"
                                     PlaceholderText="Master-Passwort"
                                     PasswordRevealMode="Peek"
                                     MaxLength="256"
                                     MinHeight="46"
                                     Padding="14,12,10,10"
                                     CornerRadius="12"
                                     Margin="0,8,0,0"
                                     KeyDown="PasswordBox_KeyDown"
                                     PasswordChanged="MasterPassword_Changed" />

                        <!-- Nur beim Erstellen eines neuen Tresors -->
                        <StackPanel x:Name="CreatePanel"
                                    Spacing="12"
                                    Visibility="Collapsed">
                            <PasswordBox x:Name="ConfirmPasswordBox"
                                         PlaceholderText="Master-Passwort wiederholen"
                                         PasswordRevealMode="Peek"
                                         MaxLength="256"
                                         MinHeight="46"
                                         Padding="14,12,10,10"
                                         CornerRadius="12"
                                         KeyDown="PasswordBox_KeyDown" />
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid Height="6" VerticalAlignment="Center">
                                    <Border CornerRadius="3"
                                            Background="{ThemeResource SubtleFillColorSecondaryBrush}" />
                                    <Border x:Name="StrengthFill" CornerRadius="3" />
                                </Grid>
                                <TextBlock x:Name="StrengthLabel"
                                           Grid.Column="1"
                                           Text="—"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Grid>
                            <TextBlock Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                       TextWrapping="Wrap"
                                       Text="Mindestens 8 Zeichen. Das Master-Passwort kann nicht wiederhergestellt werden – merke es dir gut." />
                        </StackPanel>

                        <!-- Fehlermeldung -->
                        <Border x:Name="ErrorPanel"
                                Visibility="Collapsed"
                                CornerRadius="12"
                                Padding="12,10"
                                Background="#26EF4444"
                                BorderBrush="#66EF4444"
                                BorderThickness="1">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Glyph="&#xE783;" FontSize="16"
                                          Foreground="{StaticResource DangerBrush}" />
                                <TextBlock x:Name="ErrorText"
                                           TextWrapping="Wrap"
                                           MaxWidth="300"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <Button x:Name="UnlockButton"
                                Style="{StaticResource GradientButtonStyle}"
                                HorizontalAlignment="Stretch"
                                MinHeight="48"
                                Click="UnlockButton_Click" AutomationProperties.Name="Entsperren">
                            <Grid>
                                <StackPanel x:Name="UnlockButtonContent"
                                            Orientation="Horizontal"
                                            Spacing="10">
                                    <TextBlock x:Name="UnlockButtonText" Text="Entsperren" />
                                    <FontIcon x:Name="UnlockArrow" Glyph="&#xE72A;" FontSize="14" />
                                </StackPanel>
                                <ProgressRing x:Name="BusyRing"
                                              Width="20" Height="20"
                                              Foreground="White"
                                              IsActive="False"
                                              Visibility="Collapsed" />
                            </Grid>
                        </Button>

                        <StackPanel x:Name="HelloPanel"
                                    Spacing="14"
                                    Visibility="Collapsed">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                                <TextBlock Grid.Column="1" Text="oder"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                <Rectangle Grid.Column="2" Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                            </Grid>
                            <Button x:Name="WindowsHelloButton"
                                    HorizontalAlignment="Stretch"
                                    MinHeight="46"
                                    CornerRadius="12"
                                    Click="WindowsHelloButton_Click" AutomationProperties.Name="Mit Windows Hello entsperren">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <FontIcon Glyph="&#xEB68;" FontSize="18" />
                                    <TextBlock Text="Mit Windows Hello entsperren" />
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal"
                                    Spacing="6"
                                    HorizontalAlignment="Center"
                                    Margin="0,8,0,0">
                            <FontIcon Glyph="&#xEA18;" FontSize="12"
                                      Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            <TextBlock Text="Lokal verschlüsselt · AES-256-GCM · Argon2id"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
