<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Nur iPhone. Die Windows-App bleibt das eigene Projekt PasswordVault.App. -->
    <!-- iOS-26-SDK fest, weil GitHubs Mac-Rechner (noch) Xcode 26 haben; das neueste SDK verlangt Xcode 27 -->
    <TargetFramework>net10.0-ios26.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>PasswordVault.Mobile</RootNamespace>

    <ApplicationTitle>Password Vault</ApplicationTitle>
    <ApplicationId>de.privat.passwordvault</ApplicationId>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>

    <!-- AesGcm gibt es unter iOS erst ab 13; 15 deckt alle aktuellen iPhones ab -->
    <SupportedOSPlatformVersion>15.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <ItemGroup>
    <MauiIcon Include="Resources\AppIcon\appicon.svg" />
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#050505" BaseSize="128,128" />
    <MauiFont Include="Resources\Fonts\*.ttf" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PasswordVault.Core\PasswordVault.Core.csproj" />
  </ItemGroup>

</Project>
