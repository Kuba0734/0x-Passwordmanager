<Page
    x:Class="PasswordVault.App.Views.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">

    <Page.Resources>
        <local:CategoryToIconConverter
            x:Key="CategoryIcon"
            xmlns:local="using:PasswordVault.App.Helpers" />
    </Page.Resources>

    <NavigationView
        x:Name="NavView"
        IsBackButtonVisible="Collapsed"
        PaneDisplayMode="Left"
        OpenPaneLength="240"
        IsSettingsVisible="True"
        SelectionChanged="NavView_SelectionChanged">

        <!-- Seitenleiste: Kategorien -->
        <NavigationView.MenuItems>
            <NavigationViewItem Content="Alle Einträge"
                                Icon="List" Tag="all" />
            <NavigationViewItem Content="Favoriten"
                                Icon="Favorite" Tag="favorites" />
            <NavigationViewItemSeparator />
            <NavigationViewItem Content="Logins"
                                Icon="Contact" Tag="logins" />
            <NavigationViewItem Content="Kreditkarten"
                                Icon="Shop" Tag="cards" />
            <NavigationViewItem Content="Notizen"
                                Icon="Page2" Tag="notes" />
        </NavigationView.MenuItems>

        <!-- Header mit Suche und "Neu"-Button -->
        <NavigationView.AutoSuggestBox>
            <AutoSuggestBox PlaceholderText="Suchen..."
                            QueryIcon="Find"
                            TextChanged="SearchBox_TextChanged" />
        </NavigationView.AutoSuggestBox>

        <!-- Hauptbereich: Content + Settings übereinander -->
        <Grid>

            <!-- Normaler Inhalt (Passwort-Liste) -->
            <Grid x:Name="ContentArea" Padding="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Kopfzeile -->
                <Grid Grid.Row="0" Margin="0,0,0,16">
                    <TextBlock x:Name="PageTitle"
                               Text="Alle Einträge"
                               FontSize="24"
                               FontWeight="SemiBold" />
                    <Button Content="+ Neuer Eintrag"
                            HorizontalAlignment="Right"
                            Style="{StaticResource AccentButtonStyle}"
                            CornerRadius="8"
                            Click="AddEntry_Click" />
                </Grid>

                <!-- Passwort-Liste -->
                <ListView x:Name="EntryListView"
                          Grid.Row="1"
                          SelectionMode="Single"
                          SelectionChanged="EntryList_SelectionChanged">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="8,12"
                                  ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Icon -->
                                <Border Grid.Column="0"
                                        Width="40" Height="40"
                                        CornerRadius="8"
                                        Background="{ThemeResource
                                            ControlFillColorDefaultBrush}">
                                    <FontIcon Glyph="{Binding Category,
                                                  Converter={StaticResource CategoryIcon}}"
                                              FontSize="18"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                                </Border>

                                <!-- Titel + Username -->
                                <StackPanel Grid.Column="1"
                                            VerticalAlignment="Center">
                                    <TextBlock
                                        Text="{Binding Title}"
                                        FontWeight="SemiBold" />
                                    <TextBlock
                                        Text="{Binding Username}"
                                        FontSize="12"
                                        Foreground="{ThemeResource
                                            TextFillColorSecondaryBrush}" />
                                </StackPanel>

                                <!-- Kopieren-Button -->
                                <Button Grid.Column="2"
                                        ToolTipService.ToolTip="Passwort kopieren"
                                        VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE8C8;"
                                              FontSize="14" />
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!-- Leer-Anzeige -->
                <StackPanel x:Name="EmptyState"
                            Grid.Row="1"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Visibility="Visible">
                    <FontIcon Glyph="&#xE785;"
                              FontSize="48"
                              Foreground="{ThemeResource
                                  TextFillColorDisabledBrush}"
                              HorizontalAlignment="Center" />
                    <TextBlock Text="Noch keine Einträge"
                               FontSize="16"
                               HorizontalAlignment="Center"
                               Foreground="{ThemeResource
                                   TextFillColorSecondaryBrush}"
                               Margin="0,12,0,0" />
                </StackPanel>
            </Grid>

            <!-- Settings (unsichtbar, wird bei Klick eingeblendet) -->
            <Frame x:Name="SettingsFrame" Visibility="Collapsed" />

        </Grid>
    </NavigationView>
</Page>