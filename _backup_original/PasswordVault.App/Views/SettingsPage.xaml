<Page
    x:Class="PasswordVault.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">

    <ScrollViewer Padding="24">
        <StackPanel Spacing="4" MaxWidth="800">

            <TextBlock Text="Einstellungen"
                       FontSize="28"
                       FontWeight="SemiBold"
                       Margin="0,0,0,24" />

            <!-- SICHERHEIT -->
            <TextBlock Text="Sicherheit"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Margin="0,16,0,8" />

            <!-- Auto-Lock -->
            <Expander HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Stretch">
                <Expander.Header>
                    <Grid Height="52"
                          ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE72E;"
                                  VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1"
                                    VerticalAlignment="Center">
                            <TextBlock Text="Auto-Lock" />
                            <TextBlock x:Name="AutoLockDescription"
                                       FontSize="12"
                                       Foreground="{ThemeResource
                                           TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Grid>
                </Expander.Header>
                <StackPanel Padding="12">
                    <ComboBox x:Name="AutoLockCombo"
                              Header="Tresor sperren nach"
                              HorizontalAlignment="Stretch"
                              SelectionChanged="AutoLock_Changed">
                        <ComboBoxItem Content="1 Minute" Tag="60" />
                        <ComboBoxItem Content="5 Minuten" Tag="300" />
                        <ComboBoxItem Content="15 Minuten" Tag="900" />
                        <ComboBoxItem Content="30 Minuten" Tag="1800" />
                        <ComboBoxItem Content="Nie" Tag="0" />
                    </ComboBox>
                </StackPanel>
            </Expander>

            <!-- Clipboard -->
            <Expander HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Stretch">
                <Expander.Header>
                    <Grid Height="52"
                          ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE8C8;"
                                  VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1"
                                    VerticalAlignment="Center">
                            <TextBlock
                                Text="Zwischenablage leeren" />
                            <TextBlock
                                x:Name="ClipboardDescription"
                                FontSize="12"
                                Foreground="{ThemeResource
                                    TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Grid>
                </Expander.Header>
                <StackPanel Padding="12">
                    <ComboBox x:Name="ClipboardCombo"
                              Header="Leeren nach"
                              HorizontalAlignment="Stretch"
                              SelectionChanged="Clipboard_Changed">
                        <ComboBoxItem Content="10 Sekunden" Tag="10" />
                        <ComboBoxItem Content="15 Sekunden" Tag="15" />
                        <ComboBoxItem Content="30 Sekunden" Tag="30" />
                        <ComboBoxItem Content="60 Sekunden" Tag="60" />
                    </ComboBox>
                </StackPanel>
            </Expander>

            <!-- Master-Passwort ändern -->
            <Button HorizontalAlignment="Stretch"
                    Height="52"
                    Padding="12,0"
                    Click="ChangeMasterPassword_Click">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE8D7;"
                              VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1"
                               Text="Master-Passwort ändern"
                               VerticalAlignment="Center" />
                </Grid>
            </Button>

            <!-- Windows Hello / PIN -->
            <Grid x:Name="WindowsHelloCard"
                  Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                  CornerRadius="8"
                  Padding="12"
                  Height="52"
                  Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <FontIcon Glyph="&#xEB68;"
                          VerticalAlignment="Center" />
                <StackPanel Grid.Column="1"
                            VerticalAlignment="Center"
                            Margin="12,0,0,0">
                    <TextBlock Text="Windows PIN" />
                    <TextBlock x:Name="WindowsHelloDescription"
                               FontSize="12"
                               Foreground="{ThemeResource
                                   TextFillColorSecondaryBrush}"
                               Text="Tresor mit Windows PIN entsperren" />
                </StackPanel>
                <ToggleSwitch x:Name="WindowsHelloToggle"
                              Grid.Column="2"
                              VerticalAlignment="Center"
                              Toggled="WindowsHello_Toggled" />
            </Grid>

            <!-- DARSTELLUNG -->
            <TextBlock Text="Darstellung"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Margin="0,32,0,8" />

            <!-- Theme -->
            <Expander HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Stretch">
                <Expander.Header>
                    <Grid Height="52"
                          ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE790;"
                                  VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1"
                                   Text="Design"
                                   VerticalAlignment="Center" />
                    </Grid>
                </Expander.Header>
                <RadioButtons x:Name="ThemeRadio"
                              SelectionChanged="Theme_Changed">
                    <RadioButton Content="System" Tag="System" />
                    <RadioButton Content="Hell" Tag="Light" />
                    <RadioButton Content="Dunkel" Tag="Dark" />
                </RadioButtons>
            </Expander>

            <!-- DATEN -->
            <TextBlock Text="Daten"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Margin="0,32,0,8" />

            <!-- Export -->
            <Button HorizontalAlignment="Stretch"
                    Height="52"
                    Padding="12,0"
                    Click="ExportCsv_Click">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xEDE1;"
                              VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1"
                               Text="Als CSV exportieren"
                               VerticalAlignment="Center" />
                </Grid>
            </Button>

            <!-- Import -->
            <Button HorizontalAlignment="Stretch"
                    Height="52"
                    Padding="12,0"
                    Click="ImportCsv_Click">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE8B5;"
                              VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1"
                               Text="Aus CSV importieren"
                               VerticalAlignment="Center" />
                </Grid>
            </Button>

            <!-- Speicherort -->
            <TextBlock Text="Speicherort"
           FontSize="16"
           FontWeight="SemiBold"
           Margin="0,32,0,8" />

            <Grid Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
      CornerRadius="8"
      Padding="12"
      ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <FontIcon Glyph="&#xE8B7;"
              VerticalAlignment="Center" />
                <TextBlock x:Name="VaultPathText"
               Grid.Column="1"
               VerticalAlignment="Center"
               FontSize="12"
               IsTextSelectionEnabled="True"
               TextWrapping="Wrap"
               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <Button Grid.Column="2"
            ToolTipService.ToolTip="Pfad kopieren"
            VerticalAlignment="Center"
            Click="CopyVaultPath_Click">
                    <FontIcon Glyph="&#xE8C8;" FontSize="14" />
                </Button>
            </Grid>

            <!-- Info -->
            <TextBlock Text="Über"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Margin="0,32,0,8" />
            <TextBlock FontSize="12"
                       Foreground="{ThemeResource
                           TextFillColorSecondaryBrush}"
                       Text="Password Vault v1.0 — Verschlüsselung: AES-256-GCM, Schlüsselableitung: Argon2id" />

        </StackPanel>
    </ScrollViewer>
</Page>
