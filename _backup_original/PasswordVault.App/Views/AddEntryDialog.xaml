<ContentDialog
    x:Class="PasswordVault.App.Views.AddEntryDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Neuer Eintrag"
    PrimaryButtonText="Speichern"
    CloseButtonText="Abbrechen"
    DefaultButton="Primary"
    CornerRadius="12"
    MinWidth="450">

    <StackPanel Spacing="16" MinWidth="400">

        <!-- Titel -->
        <TextBox x:Name="TitleBox"
                 Header="Titel"
                 PlaceholderText="z.B. GitHub, Netflix..."
                 CornerRadius="8" />

        <!-- Benutzername -->
        <TextBox x:Name="UsernameBox"
                 Header="Benutzername / E-Mail"
                 PlaceholderText="user@example.com"
                 CornerRadius="8" />

        <!-- Passwort mit Generator -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <PasswordBox x:Name="PasswordBox"
                         Header="Passwort"
                         PlaceholderText="Passwort eingeben"
                         CornerRadius="8" />
            <Button Grid.Column="1"
                    ToolTipService.ToolTip="Passwort generieren"
                    VerticalAlignment="Bottom"
                    Margin="8,0,0,0"
                    Click="GeneratePassword_Click">
                <FontIcon Glyph="&#xE8B1;"
                          FontSize="16" />
            </Button>
        </Grid>

        <!-- URL -->
        <TextBox x:Name="UrlBox"
                 Header="Website-URL"
                 PlaceholderText="https://github.com"
                 CornerRadius="8" />

        <!-- Kategorie -->
        <ComboBox x:Name="CategoryBox"
                  Header="Kategorie"
                  SelectedIndex="0"
                  HorizontalAlignment="Stretch"
                  CornerRadius="8">
            <ComboBoxItem Content="Allgemein" />
            <ComboBoxItem Content="Logins" />
            <ComboBoxItem Content="Kreditkarten" />
            <ComboBoxItem Content="Notizen" />
        </ComboBox>

        <!-- Notizen -->
        <TextBox x:Name="NotesBox"
                 Header="Notizen"
                 PlaceholderText="Optionale Notizen..."
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 MinHeight="80"
                 CornerRadius="8" />

    </StackPanel>
</ContentDialog>
